  "nodes": [
    {
      "id": "the_traveler",
      "name": "The Traveler",
      "type": "character",
      "base_description": "A person who travels and arrives in Inazuma: who enforces isolation and the Vision Hunt Decree—confiscating Visions from citizens of a nation ruled by the Electro Archon, stripping many of their ambition and purpose; a protagonist who travels to different worlds, arriving in Inazuma and meeting allies like Ayaka and Thoma and witnesses the growing oppression. A resistance led by Sangonomiya Kokomi is involved with this character's presence. The Traveler fights against the Shogunate and is revealed to be connected to the true Archon, Raiden Ei, who has retreated into the Plane of Euthymia, leaving a puppet Shogun to enforce her ideals. A character who arrives in Inazuma and confronts the Shogun; the will of Inazuma’s people embodied in their Visions; Ei realizes the harm of her ideology. Additionally, this being abandons the Vision Hunt Decree and guides Inazuma towards a new future, restores the Visions, ends the civil conflict, and begins guiding Inazuma toward a new future.",
      "base_attributes": {},
      "states": [
        {
          "sid": "vision_hunt_decree_the_traveler_0",
          "current_description": "A protagonist who arrives in Inazuma, enforces the Vision Hunt Decree initially but later confronts the Shogunate and guides Inazuma towards a new future by abandoning the decree.",
          "current_attributes": {
            "role": "key player in Inazuman politics"
          },
          "time_start_event": "Vision Hunt Decree",
          "time_end_event": "abandons the Vision Hunt Decree"
        },
        {
          "sid": "arrival_in_inazuma_the_traveler_1",
          "current_description": "A protagonist who has become involved in the political and social turmoil of Inazuma, meeting allies and witnessing oppression, and is now a key figure in the resistance against the Shogunate's rule.",
